# =============================================================================
# AeroSentinel - Environment Configuration
# Copy this file to .env and fill in actual values
# =============================================================================

# ---- Database (PostgreSQL + TimescaleDB) ----
DATABASE_URL=postgresql+asyncpg://aerosentinel:changeme_db_password@postgres:5432/aerosentinel
POSTGRES_USER=aerosentinel
POSTGRES_PASSWORD=changeme_db_password
POSTGRES_DB=aerosentinel

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- MQTT Broker (EMQX) ----
MQTT_BROKER_HOST=emqx
MQTT_BROKER_PORT=1883
MQTT_USERNAME=aerosentinel
MQTT_PASSWORD=changeme_mqtt_password

# ---- MinIO (Object Storage) ----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=aerosentinel
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_BUCKET=aerosentinel-media
MINIO_USE_SSL=false

# ---- AI / ML ----
AI_MODEL_PATH=/app/models/detection_model.onnx

# ---- Frontend ----
MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# ---- Application ----
SECRET_KEY=changeme_generate_a_64_char_random_string_here
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
LOG_LEVEL=INFO

# ---- EMQX Dashboard ----
EMQX_DASHBOARD__DEFAULT_USERNAME=admin
EMQX_DASHBOARD__DEFAULT_PASSWORD=changeme_emqx_dashboard
